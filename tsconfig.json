{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "jsx": "react-jsx",
        "allowJs": false,
        "strict": true,
        "skipLibCheck": true,
        "noUncheckedSideEffectImports": false,
        "moduleResolution": "bundler",
        "target": "ESNext",
        "noEmit": true
    },
    "include": ["resources/js/**/*"]
}
